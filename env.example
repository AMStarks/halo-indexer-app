# Halo Indexer Environment Configuration

# Node Environment
NODE_ENV=development
PORT=3000

# Node Identification
NODE_ID=indexer-1

# Redis Configuration
REDIS_URL=redis://localhost:6379

# PostgreSQL Configuration (for future use)
POSTGRES_URL=postgresql://postgres:password@localhost:5432/halo_indexer

# TLS API Configuration
TLS_API_ENDPOINT=https://api.telestai.io

# Leader Election
LEADER_ELECTION_ENABLED=true

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=5

# Sequential Code Configuration
SEQUENTIAL_CODE_LENGTH=32

# Security
JWT_SECRET=your-jwt-secret-here
API_KEY=your-api-key-here 
JWT_ISSUER=halo-indexer
JWT_AUDIENCE=lasko-clients
JWT_EXPIRES_SECONDS=900
HALO_CHALLENGE_TTL=120

# Post Verification
# Bundle identifier used in the canonical message for post signatures.
# Must match the client's bundleId (e.g., com.telestai.lasko)
BUNDLE_ID=com.telestai.LASKO

# Enforce signature verification for posts (true|false)
ENFORCE_POST_SIGNATURE=true

# Maximum allowed timestamp skew for posts (in seconds)
POST_MAX_SKEW_SECONDS=120

# Allow global feed fallback when author has no posts (true|false)
ALLOW_GLOBAL_FEED=true